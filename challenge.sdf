<?xml version="1.0"?>
<sdf version="1.9">
  <world name="challenge_world">
	<scene>
 	 <ambient>1.0 1.0 1.0 1</ambient>
 	 <background>0.8 0.8 0.8 1</background>
	</scene>

    <physics name="1ms" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"></plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"></plugin>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"></plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"></plugin>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1.0 1.0 1.0 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.3 0.2 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
	<ambient>0.3 0.3 0.3 1</ambient>
	<diffuse>0.3 0.3 0.3 1</diffuse>
	</material>
        </visual>
      </link>
    </model>

    <model name="wall_1">
      <static>true</static>
      <pose>5 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1 6 1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1 6 1</size></box></geometry>
          <material>
	<ambient>0.6 0.2 0.2 1</ambient>
	<diffuse>0.6 0.2 0.2 1</diffuse>
	</material></visual>
      </link>
    </model>

    <model name="wall_2">
      <static>true</static>
      <pose>10 -3 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1 6 1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1 6 1</size></box></geometry>
          <material>
<ambient>0.6 0.2 0.2 1</ambient>
<diffuse>0.6 0.2 0.2 1</diffuse>
</material></visual>
      </link>
    </model>

    <model name="vehicle">
      <pose>0 0 0.25 0 0 0</pose>
      <link name="chassis">
        <inertial>
          <mass>5</mass>
          <inertia><ixx>0.5</ixx><iyy>0.5</iyy><izz>0.5</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="collision"><geometry><box><size>0.5 0.3 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.5 0.3 0.5</size></box></geometry>
          <material>
	<ambient>0.1 0.3 0.9 1</ambient>
	<diffuse>0.1 0.3 0.9 1</diffuse>
	</material></visual>
      </link>
      <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
        <topic>/model/vehicle/cmd_vel</topic>
      </plugin>
      <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
        <odom_topic>/model/vehicle/odometry</odom_topic>
        <odom_frame>world</odom_frame>
        <robot_base_frame>vehicle</robot_base_frame>
      </plugin>
    </model>
  </world>
</sdf>
